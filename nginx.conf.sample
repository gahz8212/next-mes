# nginx.conf.sample
# Production Nginx Configuration for AWS EC2 + Cloudflare Full SSL

server {
    listen 80;
    listen 443 ssl http2;
    server_name mes.memyself.shop;

    root /var/www/next-mes;
    index dashboard.html index.html;
    charset utf-8;

    # SSL configuration (managed by Certbot)
    # ssl_certificate /etc/letsencrypt/live/mes.memyself.shop/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/mes.memyself.shop/privkey.pem;

    # 1. Backend API Routing: /backend/api/* -> backend/index.php
    location ~ ^/backend/api/ {
        rewrite ^ /backend/index.php last;
    }

    # 2. Unified Backend Front Controller
    location = /backend/index.php {
        include fastcgi_params;
        fastcgi_pass unix:/var/run/php/php8.3-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param REQUEST_URI $request_uri;
    }

    # 3. PHP-FPM FastCGI Handler
    location ~ \.php$ {
        include fastcgi_params;
        fastcgi_pass unix:/var/run/php/php8.3-fpm.sock;
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
    }

    # 4. Frontend Static Files (SPA Fallback)
    location / {
        try_files $uri $uri/ /dashboard.html;
    }

    # 5. Security: Deny access to hidden files (.env, .git, etc.)
    location ~ /\.(?!well-known).* {
        deny all;
    }
}
